## ---- 2. Data generator ---------------------------------------------------
gen_series <- function(n, p0, b_occ, b_amt, dist = "gamma") {
  t  <- 1:n                                                  # time index
  tc <- (t - (n + 1) / 2) / (n - 1)                          # centred time in [-0.5, 0.5]
  pw <- plogis(qlogis(1 - p0) + b_occ * tc)                  # wet probability at each t
  mu <- MU0 * exp(b_amt * tc)                                # mean wet amount at each t
  wet <- rbinom(n, 1, pw)                                    # wet/dry indicator
  amt <- if (dist == "gamma") {
    rgamma(n, shape = SHAPE, rate = SHAPE / mu)              # gamma amount with mean mu
  } else {
    mu * exp(SIG_LN * rnorm(n) - SIG_LN^2 / 2)               # lognormal amount with mean mu
  }
  list(y = wet * amt, pw = pw, mu = mu)                      # y = 0 on dry steps
}

## ---- 3. Exact null of Kendall S (no ties) --------------------------------
kend_null <- function(nmax) {                                # pmf of inversions for m = 1..nmax
  out <- vector("list", nmax); f <- 1                        # m = 1: 0 inversions
  out[[1]] <- f                                              # store m = 1
  for (k in 2:nmax) {                                        # add the k-th element
    g  <- c(f, rep(0, k - 1))                                # pad for new support
    cs <- cumsum(g)                                          # running sums
    f  <- (cs - c(rep(0, k), cs[seq_len(length(g) - k)])) / k  # convolve with uniform{0..k-1}
    out[[k]] <- f                                            # store pmf for m = k
  }
  out
}
KEND <- kend_null(max(N_GRID))                               # precompute once

## ---- 4. Core functions (step01) ------------------------------------------
S_stat <- function(x) {                                      # Kendall S against time order
  d <- outer(x, x, "-")                                      # pairwise differences
  sum(sign(d[lower.tri(d)]))                                 # sum sign(x_j - x_i), j > i
}

mk_asym <- function(x) {                                     # MK, tie-corrected normal approx
  n <- length(x)                                             # sample size
  if (n < 3) return(c(S = 0, z = 0, p = 1))                  # too short
  S <- S_stat(x)                                             # trend statistic
  tie <- rle(sort(x))$lengths                                # tied group sizes
  v <- (n * (n - 1) * (2 * n + 5) - sum(tie * (tie - 1) * (2 * tie + 5))) / 18  # Var(S)
  if (v <= 0) return(c(S = S, z = 0, p = 1))                 # constant series
  z <- if (S > 0) (S - 1) / sqrt(v) else if (S < 0) (S + 1) / sqrt(v) else 0  # continuity-corrected z
  c(S = S, z = z, p = 2 * pnorm(-abs(z)))                    # two-sided p
}

p_amt_exact <- function(S, m) {                              # exact p for positives (no ties)
  if (m < 2) return(c(p = 1, mid = 1))                       # nothing to test
  k <- (m * (m - 1) / 2 - abs(S)) / 2                        # inversions at observed |S|
  f <- KEND[[m]]                                             # exact pmf
  lo <- sum(f[seq_len(k)]); eq <- f[k + 1]                   # P(inv < k), P(inv = k)
  c(p = min(1, 2 * (lo + eq)), mid = min(1, 2 * (lo + eq / 2)))  # conventional and mid-p
}

p_occ_exact <- function(S, n, m) {                           # exact p for wet/dry pattern
  if (m == 0 || m == n) return(c(p = 1, mid = 1))            # no variation
  U <- (S + m * (n - m)) / 2                                 # MK on 0/1 = Mann-Whitney U
  u <- min(U, m * (n - m) - U)                               # lower-tail distance
  lo <- if (u > 0) pwilcox(u - 1, m, n - m) else 0           # P(U < u)
  eq <- dwilcox(u, m, n - m)                                 # P(U = u)
  c(p = min(1, 2 * (lo + eq)), mid = min(1, 2 * (lo + eq / 2)))  # conventional and mid-p
}

sen_slope <- function(y, t) {                                # Theil-Sen slope
  if (length(y) < 2) return(NA_real_)                        # need 2 points
  d <- outer(y, y, "-"); dt <- outer(t, t, "-")              # pairwise differences
  median(d[lower.tri(d)] / dt[lower.tri(dt)])                # median pairwise slope
}

p_fisher  <- function(p1, p2) pchisq(-2 * (log(max(p1, 1e-300)) + log(max(p2, 1e-300))),
                                     df = 4, lower.tail = FALSE)          # Fisher, chi2(4)
p_stouffer <- function(z1, z2) 2 * pnorm(-abs((z1 + z2) / sqrt(2)))      # same-direction test
p_cauchy  <- function(p) {                                   # Cauchy combination of any p-vector
  p <- pmin(pmax(p, 1e-15), 1 - 1e-15)                       # keep tan() finite
  0.5 - atan(mean(tan((0.5 - p) * pi))) / pi                 # combined p
}

two_part <- function(y) {                                    # step01 statistics for one series
  n <- length(y); t <- 1:n                                   # length and time
  I <- as.numeric(y > 0); pos <- which(y > 0); m <- length(pos)  # occurrence, wet times, count
  full <- mk_asym(y); occ <- mk_asym(I); amt <- mk_asym(y[pos])  # MK full, Part 1, Part 2
  occE <- p_occ_exact(occ[["S"]], n, m); amtE <- p_amt_exact(amt[["S"]], m)  # exact parts
  b_occ <- NA_real_; dE <- NA_real_; b_amt <- NA_real_       # defaults
  if (m >= 2) b_amt <- sen_slope(log(y[pos]), pos)           # Sen slope of log amount
  if (m > 0 && m < n) {                                      # logistic needs both classes
    fit <- suppressWarnings(glm.fit(cbind(1, t), I, family = binomial()))
    a <- fit$coefficients[1]; b_occ <- fit$coefficients[2]  # logit intercept and slope
    if (!is.na(b_amt)) {                                     # E[y] change (step01 version)
      c0 <- mean(y[pos] * exp(-b_amt * pos))
      Ey <- function(s) plogis(a + b_occ * s) * c0 * exp(b_amt * s)
      dE <- Ey(n) - Ey(1)
    }
  }
  c(p_full = full[["p"]], S_full = full[["S"]], p_occ = occ[["p"]], z_occ = occ[["z"]],
    p_amt = amt[["p"]], z_amt = amt[["z"]], p_occ_ex = occE[["p"]], p_amt_ex = amtE[["p"]],
    p_fisher = p_fisher(occ[["p"]], amt[["p"]]),
    p_fisher_ex = p_fisher(occE[["p"]], amtE[["p"]]),
    p_fisher_mid = p_fisher(occE[["mid"]], amtE[["mid"]]),
    p_stouffer = p_stouffer(occ[["z"]], amt[["z"]]),
    p_cauchy = p_cauchy(c(occ[["p"]], amt[["p"]])),
    sen_full = sen_slope(y, t), b_occ = b_occ, b_amt = b_amt, dE = dE, n_wet = m)
}

