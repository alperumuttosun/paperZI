## ===========================  STEP 04  ===================================
## Serial dependence (calibrated to step03):
##  occurrence = two-state Markov chain with lag-1 correlation rhoI (0, 0.2, 0.4)
##  amounts    = gamma marginals driven by a Gaussian AR(1) copula, rhoA (0, 0.2, 0.3)
##  shapes     = 0.8 (precipitation-like) and 0.25 (streamflow-like, very heavy tail)
## Methods: naive tests, Hamed-Rao (1998) variance correction per part,
##          circular moving-block permutation of the whole series (keeps both parts' dependence)
############################################################################
R4 <- 500                                                    # replications per cell
B4 <- 199                                                    # block permutations per test
N4 <- 64                                                     # series length (typical real record)
DEP <- data.frame(dep = c("none", "moderate", "strong"),
                  rhoI = c(0, 0.2, 0.4), rhoA = c(0, 0.2, 0.3))  # dependence levels
SHAPES4 <- c(0.8, 0.25)                                      # amount gamma shapes
SCEN4 <- c("H0", "occ", "amt", "opp")                        # scenarios (step01 effect sizes)
P04 <- c(0.3, 0.6)                                           # zero shares

## ---- 22. Dependent zero-inflated generator --------------------------------------
gen_dep <- function(n, p0, b_occ, b_amt, rhoI, rhoA, shape) {
  tc <- ((1:n) - (n + 1) / 2) / (n - 1)                      # centred time
  pw <- plogis(qlogis(1 - p0) + b_occ * tc)                  # target wet probability at t
  mu <- MU0 * exp(b_amt * tc)                                # mean wet amount at t
  wet <- numeric(n); wet[1] <- rbinom(1, 1, pw[1])           # first state
  for (t in 2:n) {                                           # Markov transitions keep marginal ~ pw[t]
    pr <- if (wet[t - 1] == 1) pw[t] + rhoI * (1 - pw[t]) else pw[t] * (1 - rhoI)
    wet[t] <- rbinom(1, 1, pr)
  }
  z <- numeric(n); z[1] <- rnorm(1)                          # latent Gaussian AR(1)
  for (t in 2:n) z[t] <- rhoA * z[t - 1] + sqrt(1 - rhoA^2) * rnorm(1)
  amt <- qgamma(pnorm(z), shape = shape, rate = shape / mu)  # gamma marginal with mean mu
  wet * amt                                                  # observed series
}

## ---- 23. Hamed-Rao modified MK p-value --------------------------------------------
mk_hr <- function(x, t = seq_along(x)) {                     # Hamed & Rao (1998) variance correction
  n <- length(x); a <- mk_asym(x)                            # naive tie-corrected MK
  if (n < 6 || a[["z"]] == 0) return(c(z = a[["z"]], p = a[["p"]], f = 1))
  b <- sen_slope(x, t); r <- x - b * t                       # remove Sen trend
  R <- rank(r)                                               # ranks of residuals
  rk <- acf(R, lag.max = n - 1, plot = FALSE)$acf[-1]        # rank autocorrelations
  k <- seq_along(rk); sig <- abs(rk) > qnorm(0.975) / sqrt(n)  # keep significant lags only
  f <- 1 + 2 / (n * (n - 1) * (n - 2)) * sum(((n - k) * (n - k - 1) * (n - k - 2) * rk)[sig])  # n/n*
  f <- max(f, 1)                                             # never shrink the variance (conservative)
  z <- a[["z"]] / sqrt(f)                                    # corrected z
  c(z = z, p = 2 * pnorm(-abs(z)), f = f)
}

## ---- 24. Block permutation p-values ------------------------------------------------
fisher_stat <- function(y) {                                 # Fisher statistic from asymptotic parts (fast)
  I <- as.numeric(y > 0); pos <- which(y > 0)
  p1 <- mk_asym(I)[["p"]]; p2 <- mk_asym(y[pos])[["p"]]
  -2 * (log(max(p1, 1e-300)) + log(max(p2, 1e-300)))
}
block_perm_p <- function(y, B = B4, L = ceiling(1.5 * length(y)^(1/3))) {  # circular moving-block permutation
  n <- length(y); nb <- ceiling(n / L)                       # number of blocks
  T0 <- fisher_stat(y); S0 <- abs(S_stat(y))                 # observed two-part and MK_full statistics
  Tb <- Sb <- numeric(B)
  for (b in 1:B) {
    st <- sample.int(n, 1)                                   # random circular start
    idx <- ((st - 1 + 0:(n - 1)) %% n) + 1                   # rotated index
    blk <- split(idx, ceiling(seq_len(n) / L))               # consecutive blocks
    yb <- y[unlist(blk[sample.int(nb)])][1:n]                # shuffled block order
    Tb[b] <- fisher_stat(yb); Sb[b] <- abs(S_stat(yb))
  }
  c(p_tp_bp = (1 + sum(Tb >= T0)) / (B + 1), p_full_bp = (1 + sum(Sb >= S0)) / (B + 1))
}

## ---- 25. All step04 statistics for one series ----------------------------------------
dep_stats <- function(y) {
  n <- length(y); I <- as.numeric(y > 0); pos <- which(y > 0); m <- length(pos)
  occ <- mk_asym(I); amt <- mk_asym(y[pos])                  # naive parts
  occE <- p_occ_exact(occ[["S"]], n, m); amtE <- p_amt_exact(amt[["S"]], m)  # exact parts
  hO <- mk_hr(I); hA <- if (m >= 6) mk_hr(y[pos], pos) else c(z = 0, p = 1, f = 1)  # Hamed-Rao parts
  bp <- block_perm_p(y)                                      # block permutation
  c(p_full = mk_asym(y)[["p"]], p_full_hr = mk_hr(y)[["p"]], p_full_bp = bp[["p_full_bp"]],
    p_tp = p_fisher(occE[["mid"]], amtE[["mid"]]),           # naive two-part (exact mid-p)
    p_tp_hr = p_fisher(hO[["p"]], hA[["p"]]),                # Hamed-Rao two-part
    p_bon_hr = min(1, 2 * min(hO[["p"]], hA[["p"]])),        # Hamed-Rao Bonferroni
    p_tp_bp = bp[["p_tp_bp"]],                               # block-permutation two-part
    f_occ = hO[["f"]], f_amt = hA[["f"]], n_wet = m)         # variance inflation factors
}

