               true_bE = signif(tb, 4),
               median_bias = signif(median(e) - tb, 4),
               mean_bias = signif(mean(e) - tb, 4),
               rmse = signif(sqrt(mean((e - tb)^2)), 4),
               mad_err = signif(median(abs(e - tb)), 4),
               share_zero = round(mean(e == 0), 3),
               share_estimable = round(mean(ok), 3))
  }))
}))
