read_dly_prcp <- function(file) {                            # daily PRCP (mm) from a GHCN .dly file
  l <- readLines(file); l <- l[substr(l, 18, 21) == "PRCP"]  # precipitation records only
  yr <- as.integer(substr(l, 12, 15)); mo <- as.integer(substr(l, 16, 17))
  st <- 22 + 8 * (0:30)                                      # start column of each day's value
  val <- matrix(sapply(st, function(s) as.numeric(substr(l, s, s + 4))), nrow = length(l))  # tenths of mm
  qf  <- matrix(sapply(st, function(s) substr(l, s + 6, s + 6)), nrow = length(l))         # quality flag
  val[val == -9999 | qf != " "] <- NA                        # missing or failed QC -> NA
  out <- data.frame(year = rep(yr, 31), month = rep(mo, 31), day = rep(1:31, each = length(l)),
                    prcp = as.vector(val) / 10)              # mm
  out[out$day <= days_in_month(out$year, out$month), ]       # keep real calendar days
}

