run_cell9 <- function(k, grid, cache_dir) {                  # one cell: R4 series, all tests
  f <- file.path(cache_dir, sprintf("cell_%03d.rds", k))     # checkpoint file of this cell
  if (file.exists(f)) return(readRDS(f))                     # already done -> read it
  g <- grid[k, ]; set.seed(9000 + k)                         # cell-specific seed (reproducible)
  eff <- scen_eff[[g$scen]]                                  # trend effects of the scenario
  res <- t(replicate(R4, dep_stats(gen_dep(g$n, g$p0, eff[1], eff[2], g$rhoI, g$rhoA, g$shape))))  # simulate + test
  res <- cbind(cell = k, res); saveRDS(res, f); res          # save checkpoint and return
}

