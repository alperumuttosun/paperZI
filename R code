  todo <- sum(!file.exists(file.path(cache9_dir, sprintf("cell_%03d.rds", grid9$cell))))  # unfinished cells
  message("step09: ", todo, " of ", nrow(grid9), " cells to compute.")
  cl <- makeCluster(max(1, detectCores() - 1))               # one worker per core, one core left free
