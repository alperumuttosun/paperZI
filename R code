    data.frame(dist = d$dist[1], p0 = d$p0[1], n = d$n[1], t(round(sz, 3)))
  }))
  size2 <- size2[order(size2$dist, size2$n, size2$p0), ]       # sort
  write.csv(size2, file.path(out_dir, "step02_size_H0.csv"), row.names = FALSE)

  ## ---- 11. Expected-value trend accuracy (beta_E) --------------------------------
  true_bE <- function(n, p0, scen, dist) {                     # OLS slope of true E[y_t] on t
    eff <- scen_eff[[scen]]; tc <- ((1:n) - (n + 1) / 2) / (n - 1)
    E <- plogis(qlogis(1 - p0) + eff[1] * tc) * MU0 * exp(eff[2] * tc)  # true E[y_t] (same for both dists)
    ols_slope(E, 1:n)
  }
  est_cols <- c(TwoPart = "bE_tp", Hurdle = "bE_hur", Tobit = "bE_tob", OLS = "bE_ols",
                MeanPairSlope = "bE_mps", Sen = "bE_sen", ATS = "bE_ats")  # label -> estimate column

  slp2 <- do.call(rbind, lapply(split(raw2, raw2$cell), function(d) {
    tb <- true_bE(d$n[1], d$p0[1], d$scen[1], d$dist[1])       # target
    do.call(rbind, lapply(names(est_cols), function(m) {
      e <- d[[est_cols[m]]]; ok <- is.finite(e); e <- e[ok]    # drop non-estimable reps
      data.frame(dist = d$dist[1], scen = d$scen[1], p0 = d$p0[1], n = d$n[1], estimator = m,
                 true_bE = signif(tb, 4),
                 median_bias = signif(median(e) - tb, 4),      # robust bias
                 mean_bias = signif(mean(e) - tb, 4),          # classical bias
                 rmse = signif(sqrt(mean((e - tb)^2)), 4),     # classical RMSE
                 mad_err = signif(median(abs(e - tb)), 4),     # median absolute error (robust)
                 share_zero = round(mean(e == 0), 3),          # share of estimates exactly 0
                 share_estimable = round(mean(ok), 3))
    }))
  }))
  slp2 <- slp2[order(slp2$dist, match(slp2$scen, SCEN), slp2$estimator, slp2$n, slp2$p0), ]  # sort
  write.csv(slp2, file.path(out_dir, "step02_betaE_accuracy.csv"), row.names = FALSE)

  ## ---- 12. Figures (optional, needs ggplot2) -----------------------------------
  if (requireNamespace("ggplot2", quietly = TRUE)) {
    library(ggplot2)                                           # plotting
    for (dd in DIST) {                                         # one power figure per distribution
      sub <- rej2[rej2$dist == dd, ]                           # rows for this distribution
      long <- reshape(sub[, c("scen", "p0", "n", names(tests2))], direction = "long",
                      varying = names(tests2), v.names = "rate", timevar = "method",
                      times = names(tests2))                   # wide -> long
      long$scen <- factor(long$scen, levels = SCEN)            # scenario order
      pl <- ggplot(long, aes(p0, rate, colour = method)) +
        geom_line() + geom_point(size = 1) +
        geom_hline(yintercept = 0.05, linetype = 2) +          # nominal level
        facet_grid(n ~ scen, labeller = label_both) +
        labs(x = "Share of zeros", y = "Rejection rate (5%)", title = paste("Amounts:", dd)) +
        theme_bw(base_size = 9)
      ggsave(file.path(out_dir, paste0("step02_power_", dd, ".png")), pl, width = 11, height = 6, dpi = 200)
    }
    sl <- slp2[slp2$n == 64 & slp2$scen != "H0", ]             # beta_E errors at n = 64
    sl$scen <- factor(sl$scen, levels = SCEN)                  # scenario order
    pl2 <- ggplot(sl, aes(p0, mad_err, colour = estimator)) +  # robust error vs zero share
      geom_line() + geom_point(size = 1) +
      facet_grid(dist ~ scen, scales = "free_y") +
      labs(x = "Share of zeros", y = "Median |error| of beta_E (n = 64)") +
      theme_bw(base_size = 9)
    ggsave(file.path(out_dir, "step02_betaE_error.png"), pl2, width = 11, height = 5, dpi = 200)
  }

  ## ---- 12b. Size-adjusted power (uses cached raw2, no new simulation) -------------
  ## critical value = empirical 5% quantile of the method's p-values under H0 in the same (dist, n, p0) cell
  h0_crit <- do.call(rbind, lapply(split(raw2[raw2$scen == "H0", ], ~ dist + n + p0, drop = TRUE), function(d)
    data.frame(dist = d$dist[1], n = d$n[1], p0 = d$p0[1],
               t(sapply(tests2, function(v) unname(quantile(d[[v]], 0.05, na.rm = TRUE, type = 1)))))))  # H0 5% quantiles
  sap <- do.call(rbind, lapply(split(raw2, raw2$cell), function(d) {
    cr <- h0_crit[h0_crit$dist == d$dist[1] & h0_crit$n == d$n[1] & h0_crit$p0 == d$p0[1], ]  # matching critical values
    r <- sapply(names(tests2), function(m) mean(d[[tests2[m]]] <= cr[[m]], na.rm = TRUE))      # reject if p <= H0 quantile
    data.frame(dist = d$dist[1], scen = d$scen[1], p0 = d$p0[1], n = d$n[1], t(round(r, 3)))
  }))
  sap <- sap[sap$scen != "H0", ]                               # power only (H0 is 0.05 by construction)
  sap <- sap[order(sap$dist, match(sap$scen, SCEN), sap$n, sap$p0), ]  # sort
  write.csv(sap, file.path(out_dir, "step02_power_sizeadjusted.csv"), row.names = FALSE)  # save table

  ## worst-case relative power: each method vs the best method in the same cell (size-adjusted)
  best <- apply(sap[, names(tests2)], 1, max)                  # best power in each cell
  rel  <- sap[, names(tests2)] / ifelse(best > 0, best, NA)   # relative power (skip cells with no power)
  worst <- aggregate(rel, by = list(dist = sap$dist), FUN = function(x) min(x, na.rm = TRUE))  # worst case over all cells
  write.csv(cbind(worst[1], round(worst[-1], 3)),
            file.path(out_dir, "step02_worstcase_relpower.csv"), row.names = FALSE)  # save table

  ## ---- 13. Console summary --------------------------------------------------------
  print(rej2[rej2$n == 64, c("dist", "scen", "p0", names(tests2))], row.names = FALSE)  # n = 64 view
  message("Outputs written to: ", out_dir)                     # where files are

}                                                            # end of step02 summary block

