get_flow <- function(site_no) {                              # daily mean discharge (cfs) for one gauge
  f <- file.path(flow_dir, paste0("dv_", site_no, ".rds"))   # per-gauge cache
  if (file.exists(f)) return(readRDS(f))                     # already downloaded
  d <- tryCatch({                                            # new API first
    x <- read_waterdata_daily(monitoring_location_id = paste0("USGS-", site_no), parameter_code = "00060",
                              statistic_id = "00003",
                              time = c(sprintf("%d-01-01", min(FLOW_YEARS)), sprintf("%d-12-31", max(FLOW_YEARS))))
    x <- as.data.frame(x); data.frame(date = as.Date(x$time), q = as.numeric(x$value))
  }, error = function(e) NULL)
  if (is.null(d) || nrow(d) == 0) d <- tryCatch({            # legacy service as fallback
    x <- readNWISdv(site_no, "00060", sprintf("%d-01-01", min(FLOW_YEARS)), sprintf("%d-12-31", max(FLOW_YEARS)))
    data.frame(date = as.Date(x$Date), q = as.numeric(x[[grep("_00060_00003$", names(x))[1]]]))
  }, error = function(e) NULL)
  if (is.null(d)) return(NULL)                               # failed (e.g. hourly request limit) -> retry next run
  d <- d[!is.na(d$q) & d$q >= 0, ]                           # drop missing / invalid
  d <- d[order(d$date), ]                                    # time order
  saveRDS(d, f); d                                           # cache and return
}

