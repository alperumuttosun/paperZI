                      "p_fisher", "fisher_stat", "block_perm_p", "dep_stats", "scen_eff", "KEND",
                      "R4", "B4", "MU0"))                    # functions and constants the workers need
  ord <- grid9$cell[order(-grid9$n)]                         # long series first (better load balance)
  raw9 <- as.data.frame(do.call(rbind, parLapplyLB(cl, ord, run_cell9, grid = grid9, cache_dir = cache9_dir)))
  stopCluster(cl)                                            # close workers
  raw9 <- merge(grid9, raw9, by = "cell"); saveRDS(raw9, raw9_file)  # attach cell settings and save
  message("step09 run time: ", round(difftime(Sys.time(), t0, units = "mins"), 1), " min")
}

