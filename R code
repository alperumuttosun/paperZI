grid9$cell <- seq_len(nrow(grid9))
cache9_dir <- file.path(out_dir, "cache_step09"); dir.create(cache9_dir, showWarnings = FALSE)

run_cell9 <- function(k, grid, cache_dir) {
  f <- file.path(cache_dir, sprintf("cell_%03d.rds", k))
  if (file.exists(f)) return(readRDS(f))
  g <- grid[k, ]; set.seed(9000 + k)
  eff <- scen_eff[[g$scen]]
  res <- t(replicate(R4, dep_stats(gen_dep(g$n, g$p0, eff[1], eff[2], g$rhoI, g$rhoA, g$shape))))
  res <- cbind(cell = k, res); saveRDS(res, f); res
}

raw9_file <- file.path(out_dir, "step09_raw.rds")
if (file.exists(raw9_file)) {
  raw9 <- readRDS(raw9_file); message("step09_raw.rds found - simulation skipped.")
} else {
  t0 <- Sys.time()
  todo <- sum(!file.exists(file.path(cache9_dir, sprintf("cell_%03d.rds", grid9$cell))))
  message("step09: ", todo, " of ", nrow(grid9), " cells to compute.")
  cl <- makeCluster(max(1, detectCores() - 1))
  clusterExport(cl, c("gen_dep", "S_stat", "mk_asym", "mk_hr", "sen_slope", "p_amt_exact", "p_occ_exact",
                      "p_fisher", "fisher_stat", "block_perm_p", "dep_stats", "scen_eff", "KEND",
                      "R4", "B4", "MU0"))
  ord <- grid9$cell[order(-grid9$n)]
  raw9 <- as.data.frame(do.call(rbind, parLapplyLB(cl, ord, run_cell9, grid = grid9, cache_dir = cache9_dir)))
  stopCluster(cl)
  raw9 <- merge(grid9, raw9, by = "cell"); saveRDS(raw9, raw9_file)
  message("step09 run time: ", round(difftime(Sys.time(), t0, units = "mins"), 1), " min")
}

