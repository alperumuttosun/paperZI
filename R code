## ---- Effect-size tools ------------------------------------------------------
firth_fit <- function(t, I) {
  tc <- t - mean(t); X <- cbind(1, tc); b <- c(0, 0)
  for (i in 1:50) {
    p <- plogis(drop(X %*% b)); w <- p * (1 - p)
    Iinv <- solve(crossprod(X * sqrt(w)))
    h <- rowSums((X %*% Iinv) * X) * w
    step <- drop(Iinv %*% crossprod(X, I - p + h * (0.5 - p)))
    b <- b + step; if (max(abs(step)) < 1e-8) break
  }
  p <- plogis(drop(X %*% b)); Iinv <- solve(crossprod(X * sqrt(p * (1 - p))))
  b <- unname(b)
  c(a = b[1] - b[2] * mean(t), b = b[2], se = sqrt(Iinv[2, 2]))
}
sen_ci <- function(x, t) {
  i <- combn(length(x), 2); dt <- t[i[2, ]] - t[i[1, ]]
  sl <- sort(((x[i[2, ]] - x[i[1, ]]) / dt)[dt != 0])
  N <- length(sl); n <- length(x)
  tie <- rle(sort(x))$lengths
  v <- (n * (n - 1) * (2 * n + 5) - sum(tie * (tie - 1) * (2 * tie + 5))) / 18
  C <- qnorm(0.975) * sqrt(v)
  lo <- max(1, floor((N - C) / 2)); hi <- min(N, ceiling((N + C) / 2) + 1)
  c(b = median(sl), lo = sl[lo], hi = sl[hi])
}
betaE_fun <- function(y, t) {
  I <- as.numeric(y > 0); pos <- which(y > 0)
  if (length(pos) < 3 || length(pos) == length(y)) return(NA_real_)
  fo <- firth_fit(t, I); ph <- plogis(fo[["a"]] + fo[["b"]] * t)
  xp <- log(y[pos]); tp <- t[pos]; i <- combn(length(xp), 2); dt <- tp[i[2, ]] - tp[i[1, ]]
  bs <- median(((xp[i[2, ]] - xp[i[1, ]]) / dt)[dt != 0])
  as <- median(xp - bs * tp); sm <- mean(exp(xp - as - bs * tp))
  ols_slope(ph * exp(as + bs * t) * sm, t)
}
effects_one <- function(y, t, B = 999) {
  I <- as.numeric(y > 0); pos <- which(y > 0)
  fo <- firth_fit(t, I)
  sc <- sen_ci(log(y[pos]), t[pos])
  bE <- betaE_fun(y, t)
  bb <- replicate(B, { k <- sample.int(length(y), replace = TRUE); betaE_fun(y[k], t[k]) })
  q <- quantile(bb, c(0.025, 0.975), na.rm = TRUE)
  c(b_occ = fo[["b"]], b_occ_lo = fo[["b"]] - 1.96 * fo[["se"]], b_occ_hi = fo[["b"]] + 1.96 * fo[["se"]],
    b_amt = sc[["b"]], b_amt_lo = sc[["lo"]], b_amt_hi = sc[["hi"]],
    betaE = bE, betaE_lo = q[[1]], betaE_hi = q[[2]])
}

