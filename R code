## ---- 6. Extra tools for competitors ---------------------------------------
firth_logit <- function(t, I, maxit = 50) {                  # Firth bias-reduced logistic (no separation blow-up)
  X <- cbind(1, t - mean(t)); b <- c(0, 0)                   # centred design, start at 0
  for (i in 1:maxit) {
    p <- plogis(drop(X %*% b)); w <- p * (1 - p)             # fitted probs and weights
    Iinv <- solve(crossprod(X * sqrt(w)))                    # inverse Fisher information
    h <- rowSums((X %*% Iinv) * X) * w                       # leverages
    step <- Iinv %*% crossprod(X, I - p + h * (0.5 - p))     # modified score step
    b <- b + drop(step)                                      # update
    if (max(abs(step)) < 1e-8) break                         # converged
  }
  c(a = b[1] - b[2] * mean(t), b = b[2])                     # back to uncentred intercept
}

ols_slope <- function(y, t) sum((t - mean(t)) * (y - mean(y))) / sum((t - mean(t))^2)  # OLS slope

mean_pair_slope <- function(y, t) {                          # mean of pairwise slopes (NAS 2020 workaround)
  d <- outer(y, y, "-"); dt <- outer(t, t, "-")              # pairwise differences
  mean(d[lower.tri(d)] / dt[lower.tri(dt)])                  # mean instead of median
}

ats_slope <- function(y, t, iters = 30) {                    # Akritas-Theil-Sen slope, zeros treated as "<DL"
  pos <- y > 0; if (sum(pos) < 2) return(NA_real_)           # need detected values
  DL <- min(y[pos]) * (1 - 1e-9); cens <- !pos               # "<DL" just below the smallest positive
  n <- length(y); pr <- which(lower.tri(matrix(0, n, n)), arr.ind = TRUE)  # all pairs (later i, earlier j)
  I <- pr[, 1]; J <- pr[, 2]                                 # pair indices
  ci <- cens[I]; cj <- cens[J]                               # censoring status in each pair
  both <- ci & cj                                            # both censored: never decidable
  S_of_b <- function(b) {                                    # Kendall S of censored residuals
    v <- ifelse(cens, DL - b * t, y - b * t)                 # residual (upper bound if censored)
    dv <- v[I] - v[J]                                        # later minus earlier
    s <- sign(dv)                                            # default: both detected
    s[both | (ci & !cj & dv > 0) | (!ci & cj & dv < 0)] <- 0 # undecidable comparisons
    sum(s)                                                   # S(b)
  }
  B <- diff(range(y)) + 1e-6                                 # |slope| cannot exceed the data range
  bisect <- function(low_side) {                             # bisection on non-increasing S(b)
    lo <- -B; hi <- B
    for (k in 1:iters) {
      mid <- (lo + hi) / 2; s <- S_of_b(mid)                 # evaluate S at midpoint
      go_up <- if (low_side) s > 0 else s >= 0               # which half holds the boundary
      if (go_up) lo <- mid else hi <- mid                    # shrink bracket
    }
    (lo + hi) / 2
  }
  (bisect(TRUE) + bisect(FALSE)) / 2                         # midpoint of the zero set of S(b)
}

qr_rankscore_p <- function(y, x, taus = c(0.25, 0.5, 0.75)) {  # quantile rank-score test, Cauchy over taus
  if (length(y) < 5) return(1)                               # too few positives
  xc <- x - mean(x)                                          # centred covariate
  p <- sapply(taus, function(tau) {
    psi <- tau - (y < quantile(y, tau, type = 1))            # quantile score under H0
    z <- sum(xc * psi) / sqrt(tau * (1 - tau) * sum(xc^2))   # standardised score
    2 * pnorm(-abs(z))                                       # two-sided p
  })
  p_cauchy(p)                                                # combine quantile levels
}

## ---- 7. All statistics for one series (step02) -----------------------------
comp_stats <- function(y) {
  n <- length(y); t <- 1:n                                   # length and time
  I <- as.numeric(y > 0); pos <- which(y > 0); m <- length(pos)  # occurrence, wet times, count
  ## --- tests ---
  full <- mk_asym(y); occ <- mk_asym(I); amt <- mk_asym(y[pos])  # MK full and parts
  occE <- p_occ_exact(occ[["S"]], n, m); amtE <- p_amt_exact(amt[["S"]], m)  # exact parts
  p_tp  <- p_fisher(occE[["mid"]], amtE[["mid"]])           # proposed: Fisher of exact mid-p parts
  p_bon <- min(1, 2 * min(occE[["p"]], amtE[["p"]]))         # two separate MK + Bonferroni
  p_lr_occ <- 1; p_hurdle <- 1; p_ziq <- 1                    # defaults
  g1 <- NULL; g2 <- NULL                                     # fitted GLMs (filled below)
  if (m > 0 && m < n) {                                      # logistic part needs both classes
    g1 <- suppressWarnings(glm.fit(cbind(1, t), I, family = binomial()))  # logit(p_t) = a + b t
    lr1 <- max(0, g1$null.deviance - g1$deviance)            # LR statistic for occurrence slope
    p_lr_occ <- pchisq(lr1, 1, lower.tail = FALSE)           # LR p-value
    lr2 <- 0                                                 # amount part LR (gamma GLM)
    if (m >= 3) {
      g2 <- tryCatch(suppressWarnings(glm.fit(cbind(1, pos), y[pos],
                     family = Gamma(link = "log"))), error = function(e) NULL)  # log mean = c + d t
      if (!is.null(g2) && g2$converged) {
        phi <- sum((y[pos] - g2$fitted.values)^2 / g2$fitted.values^2) / (m - 2)  # Pearson dispersion
        lr2 <- max(0, (g2$null.deviance - g2$deviance) / phi)  # scaled deviance drop
      }
    }
    p_hurdle <- pchisq(lr1 + lr2, 2, lower.tail = FALSE)     # hurdle joint test, chi2(2)
    p_ziq <- p_fisher(p_lr_occ, qr_rankscore_p(y[pos], pos)) # ZIQRank-type: logistic + quantile rank-score
  }
  tob <- tryCatch(survreg(Surv(y, y > 0, type = "left") ~ t, dist = "gaussian"),
                  error = function(e) NULL)                  # Tobit (left-censored at 0)
  p_tobit <- if (is.null(tob)) NA_real_ else {
    z <- unname(coef(tob)[2] / sqrt(vcov(tob)[2, 2])); 2 * pnorm(-abs(z)) }  # Wald p for slope
  ## --- expected-value trend beta_E (OLS slope of E[y_t] on t) ---
  bE_tp <- NA_real_; bE_hur <- NA_real_; bE_tob <- NA_real_  # defaults
  if (m >= 3 && m < n) {
    fo <- firth_logit(t, I)                                  # Firth logistic for occurrence
    ph <- plogis(fo[["a"]] + fo[["b"]] * t)                  # fitted wet probability
    bs <- sen_slope(log(y[pos]), pos)                        # Sen slope of log amount
    as <- median(log(y[pos]) - bs * pos)                     # median intercept
    sm <- mean(exp(log(y[pos]) - as - bs * pos))             # smearing factor (median -> mean)
    bE_tp <- ols_slope(ph * exp(as + bs * t) * sm, t)        # two-part plug-in beta_E
    if (!is.null(g2) && g2$converged) {
      mh <- exp(g2$coefficients[1] + g2$coefficients[2] * t) # gamma-GLM mean curve
      bE_hur <- ols_slope(plogis(g1$coefficients[1] + g1$coefficients[2] * t) * mh, t)  # hurdle plug-in
    }
  }
  if (!is.null(tob)) {                                       # Tobit expected value curve
    eta <- coef(tob)[1] + coef(tob)[2] * t; s <- tob$scale   # latent mean and sd
    bE_tob <- ols_slope(pnorm(eta / s) * eta + s * dnorm(eta / s), t)  # E[max(0, latent)]
  }
  c(p_full = full[["p"]], p_zd = amt[["p"]], p_tp = p_tp, p_bon = p_bon,
    p_ziq = p_ziq, p_hurdle = p_hurdle, p_tobit = p_tobit,
    bE_tp = bE_tp, bE_hur = bE_hur, bE_tob = bE_tob,
    bE_ols = ols_slope(y, t), bE_mps = mean_pair_slope(y, t),
    bE_sen = sen_slope(y, t), bE_ats = ats_slope(y, t), n_wet = m)
}

