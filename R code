## ---- Dependent zero-inflated generator --------------------------------------
gen_dep <- function(n, p0, b_occ, b_amt, rhoI, rhoA, shape) {
  tc <- ((1:n) - (n + 1) / 2) / (n - 1)
  pw <- plogis(qlogis(1 - p0) + b_occ * tc)
  mu <- MU0 * exp(b_amt * tc)
  wet <- numeric(n); wet[1] <- rbinom(1, 1, pw[1])
  for (t in 2:n) {
    pr <- if (wet[t - 1] == 1) pw[t] + rhoI * (1 - pw[t]) else pw[t] * (1 - rhoI)
    wet[t] <- rbinom(1, 1, pr)
  }
  z <- numeric(n); z[1] <- rnorm(1)
  for (t in 2:n) z[t] <- rhoA * z[t - 1] + sqrt(1 - rhoA^2) * rnorm(1)
  amt <- qgamma(pnorm(z), shape = shape, rate = shape / mu)
  wet * amt
}

## ---- Hamed-Rao corrected MK -------------------------------------------------
mk_hr <- function(x, t = seq_along(x)) {
  n <- length(x); a <- mk_asym(x)
  if (n < 6 || a[["z"]] == 0) return(c(z = a[["z"]], p = a[["p"]], f = 1))
  b <- sen_slope(x, t); r <- x - b * t
  R <- rank(r)
  rk <- acf(R, lag.max = n - 1, plot = FALSE)$acf[-1]
  k <- seq_along(rk); sig <- abs(rk) > qnorm(0.975) / sqrt(n)
  f <- 1 + 2 / (n * (n - 1) * (n - 2)) * sum(((n - k) * (n - k - 1) * (n - k - 2) * rk)[sig])
  f <- max(f, 1)
  z <- a[["z"]] / sqrt(f)
  c(z = z, p = 2 * pnorm(-abs(z)), f = f)
}

## ---- Circular moving-block permutation --------------------------------------
fisher_stat <- function(y) {
  I <- as.numeric(y > 0); pos <- which(y > 0)
  p1 <- mk_asym(I)[["p"]]; p2 <- mk_asym(y[pos])[["p"]]
  -2 * (log(max(p1, 1e-300)) + log(max(p2, 1e-300)))
}
block_perm_p <- function(y, B = B4, L = ceiling(1.5 * length(y)^(1/3))) {  # circular moving-block permutation
  n <- length(y); nb <- ceiling(n / L)
  T0 <- fisher_stat(y); S0 <- abs(S_stat(y))
  Tb <- Sb <- numeric(B)
  for (b in 1:B) {
    st <- sample.int(n, 1)
    idx <- ((st - 1 + 0:(n - 1)) %% n) + 1
    blk <- split(idx, ceiling(seq_len(n) / L))
    yb <- y[unlist(blk[sample.int(nb)])][1:n]
    Tb[b] <- fisher_stat(yb); Sb[b] <- abs(S_stat(yb))
  }
  c(p_tp_bp = (1 + sum(Tb >= T0)) / (B + 1), p_full_bp = (1 + sum(Sb >= S0)) / (B + 1))
}

## ---- Statistics for one dependent series ------------------------------------
dep_stats <- function(y) {
  n <- length(y); I <- as.numeric(y > 0); pos <- which(y > 0); m <- length(pos)
  occ <- mk_asym(I); amt <- mk_asym(y[pos])
  occE <- p_occ_exact(occ[["S"]], n, m); amtE <- p_amt_exact(amt[["S"]], m)
  hO <- mk_hr(I); hA <- if (m >= 6) mk_hr(y[pos], pos) else c(z = 0, p = 1, f = 1)
  bp <- block_perm_p(y)
  c(p_full = mk_asym(y)[["p"]], p_full_hr = mk_hr(y)[["p"]], p_full_bp = bp[["p_full_bp"]],
    p_tp = p_fisher(occE[["mid"]], amtE[["mid"]]),
    p_tp_hr = p_fisher(hO[["p"]], hA[["p"]]),
    p_bon_hr = min(1, 2 * min(hO[["p"]], hA[["p"]])),
    p_tp_bp = bp[["p_tp_bp"]],
    f_occ = hO[["f"]], f_amt = hA[["f"]], n_wet = m)
}

