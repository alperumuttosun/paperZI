## ---- Competing tests and estimators -----------------------------------------
firth_logit <- function(t, I, maxit = 50) {
  X <- cbind(1, t - mean(t)); b <- c(0, 0)
  for (i in 1:maxit) {
    p <- plogis(drop(X %*% b)); w <- p * (1 - p)
    Iinv <- solve(crossprod(X * sqrt(w)))
    h <- rowSums((X %*% Iinv) * X) * w
    step <- Iinv %*% crossprod(X, I - p + h * (0.5 - p))
    b <- b + drop(step)
    if (max(abs(step)) < 1e-8) break
  }
  c(a = b[1] - b[2] * mean(t), b = b[2])
}

ols_slope <- function(y, t) sum((t - mean(t)) * (y - mean(y))) / sum((t - mean(t))^2)

mean_pair_slope <- function(y, t) {
  d <- outer(y, y, "-"); dt <- outer(t, t, "-")
  mean(d[lower.tri(d)] / dt[lower.tri(dt)])
}

ats_slope <- function(y, t, iters = 30) {
  pos <- y > 0; if (sum(pos) < 2) return(NA_real_)
  DL <- min(y[pos]) * (1 - 1e-9); cens <- !pos
  n <- length(y); pr <- which(lower.tri(matrix(0, n, n)), arr.ind = TRUE)
  I <- pr[, 1]; J <- pr[, 2]
  ci <- cens[I]; cj <- cens[J]
  both <- ci & cj
  S_of_b <- function(b) {
    v <- ifelse(cens, DL - b * t, y - b * t)
    dv <- v[I] - v[J]
    s <- sign(dv)
    s[both | (ci & !cj & dv > 0) | (!ci & cj & dv < 0)] <- 0
    sum(s)
  }
  B <- diff(range(y)) + 1e-6
  bisect <- function(low_side) {
    lo <- -B; hi <- B
    for (k in 1:iters) {
      mid <- (lo + hi) / 2; s <- S_of_b(mid)
      go_up <- if (low_side) s > 0 else s >= 0
      if (go_up) lo <- mid else hi <- mid
    }
    (lo + hi) / 2
  }
  (bisect(TRUE) + bisect(FALSE)) / 2
}

qr_rankscore_p <- function(y, x, taus = c(0.25, 0.5, 0.75)) {
  if (length(y) < 5) return(1)
  xc <- x - mean(x)
  p <- sapply(taus, function(tau) {
    psi <- tau - (y < quantile(y, tau, type = 1))
    z <- sum(xc * psi) / sqrt(tau * (1 - tau) * sum(xc^2))
    2 * pnorm(-abs(z))
  })
  p_cauchy(p)
}

## ---- Statistics for one simulated series ------------------------------------
comp_stats <- function(y) {
  n <- length(y); t <- 1:n
  I <- as.numeric(y > 0); pos <- which(y > 0); m <- length(pos)
  full <- mk_asym(y); occ <- mk_asym(I); amt <- mk_asym(y[pos])
  occE <- p_occ_exact(occ[["S"]], n, m); amtE <- p_amt_exact(amt[["S"]], m)
  p_tp  <- p_fisher(occE[["mid"]], amtE[["mid"]])
  p_bon <- min(1, 2 * min(occE[["p"]], amtE[["p"]]))
  p_lr_occ <- 1; p_hurdle <- 1; p_ziq <- 1
  g1 <- NULL; g2 <- NULL
  if (m > 0 && m < n) {
    g1 <- suppressWarnings(glm.fit(cbind(1, t), I, family = binomial()))
    lr1 <- max(0, g1$null.deviance - g1$deviance)
    p_lr_occ <- pchisq(lr1, 1, lower.tail = FALSE)
    lr2 <- 0
    if (m >= 3) {
      g2 <- tryCatch(suppressWarnings(glm.fit(cbind(1, pos), y[pos],
                     family = Gamma(link = "log"))), error = function(e) NULL)
      if (!is.null(g2) && g2$converged) {
        phi <- sum((y[pos] - g2$fitted.values)^2 / g2$fitted.values^2) / (m - 2)
        lr2 <- max(0, (g2$null.deviance - g2$deviance) / phi)
      }
    }
    p_hurdle <- pchisq(lr1 + lr2, 2, lower.tail = FALSE)
    p_ziq <- p_fisher(p_lr_occ, qr_rankscore_p(y[pos], pos))
  }
  tob <- tryCatch(survreg(Surv(y, y > 0, type = "left") ~ t, dist = "gaussian"),
                  error = function(e) NULL)
  p_tobit <- if (is.null(tob)) NA_real_ else {
    z <- unname(coef(tob)[2] / sqrt(vcov(tob)[2, 2])); 2 * pnorm(-abs(z)) }
  bE_tp <- NA_real_; bE_hur <- NA_real_; bE_tob <- NA_real_
  if (m >= 3 && m < n) {
    fo <- firth_logit(t, I)
    ph <- plogis(fo[["a"]] + fo[["b"]] * t)
    bs <- sen_slope(log(y[pos]), pos)
    as <- median(log(y[pos]) - bs * pos)
    sm <- mean(exp(log(y[pos]) - as - bs * pos))
    bE_tp <- ols_slope(ph * exp(as + bs * t) * sm, t)
    if (!is.null(g2) && g2$converged) {
      mh <- exp(g2$coefficients[1] + g2$coefficients[2] * t)
      bE_hur <- ols_slope(plogis(g1$coefficients[1] + g1$coefficients[2] * t) * mh, t)
    }
  }
  if (!is.null(tob)) {
    eta <- coef(tob)[1] + coef(tob)[2] * t; s <- tob$scale
    bE_tob <- ols_slope(pnorm(eta / s) * eta + s * dnorm(eta / s), t)
  }
  c(p_full = full[["p"]], p_zd = amt[["p"]], p_tp = p_tp, p_bon = p_bon,
    p_ziq = p_ziq, p_hurdle = p_hurdle, p_tobit = p_tobit,
    bE_tp = bE_tp, bE_hur = bE_hur, bE_tob = bE_tob,
    bE_ols = ols_slope(y, t), bE_mps = mean_pair_slope(y, t),
    bE_sen = sen_slope(y, t), bE_ats = ats_slope(y, t), n_wet = m)
}

