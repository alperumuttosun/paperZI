run_cell2 <- function(k, grid, cache_dir) {
  f <- file.path(cache_dir, sprintf("cell_%03d.rds", k))     # this cell's checkpoint file
  if (file.exists(f)) return(readRDS(f))                     # already done -> reuse, no recomputation
  g <- grid[k, ]; set.seed(3000 + k)                         # cell-specific seed
  eff <- scen_eff[[g$scen]]                                  # trend effects
  res <- t(replicate(R2, comp_stats(gen_series(g$n, g$p0, eff[1], eff[2], g$dist)$y)))
  res <- cbind(cell = k, res)                                # tag rows
  saveRDS(res, f)                                            # save immediately (survives interruptions)
  res
}

