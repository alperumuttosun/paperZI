read_dly_prcp <- function(file) {
  l <- readLines(file); l <- l[substr(l, 18, 21) == "PRCP"]
  yr <- as.integer(substr(l, 12, 15)); mo <- as.integer(substr(l, 16, 17))
  st <- 22 + 8 * (0:30)
  val <- matrix(sapply(st, function(s) as.numeric(substr(l, s, s + 4))), nrow = length(l))
  qf  <- matrix(sapply(st, function(s) substr(l, s + 6, s + 6)), nrow = length(l))
  val[val == -9999 | qf != " "] <- NA
  out <- data.frame(year = rep(yr, 31), month = rep(mo, 31), day = rep(1:31, each = length(l)),
                    prcp = as.vector(val) / 10)
  out[out$day <= days_in_month(out$year, out$month), ]
}

