## Streamflow data audit (uses only the cached daily files dv_<site>.rds)
############################################################################
if (!is.null(resA)) {
  audit_one <- function(site) {                              # record diagnostics for one gauge
    d <- readRDS(file.path(flow_dir, paste0("dv_", site, ".rds")))
    yr <- as.integer(format(d$date, "%Y"))
    ndays <- table(factor(yr, levels = FLOW_YEARS))          # days with a value in each year
    full <- as.integer(ndays) >= 0.9 * 365                   # >= 90 % of days observed
    miss <- FLOW_YEARS[!full]                                # years without a near-complete record
    longest_gap <- if (length(miss)) max(tapply(miss, cumsum(c(1, diff(miss) != 1)), length)) else 0
    pos <- d$q[d$q > 0]
    data.frame(id = site, first_date = min(d$date), last_date = max(d$date),
               n_years_complete = sum(full), longest_gap_years = longest_gap,
               n_missing_years = length(miss),                        # incomplete years in the window
               missing_years = if (length(miss)) paste(tapply(miss, cumsum(c(1, diff(miss) != 1)),
                                            function(v) if (length(v) > 1) paste(range(v), collapse = "-") else v),
                                     collapse = "; ") else "",          # e.g. "1986-2000"
               share_zero_days = round(mean(d$q == 0), 3),
               min_positive_cfs = if (length(pos)) min(pos) else NA,         # measurement resolution
               share_days_below_0.1cfs = round(mean(d$q > 0 & d$q < 0.1), 4))  # tiny flows (rounding-sensitive)
  }
  aud <- do.call(rbind, lapply(unique(resA$id), audit_one))
  aud <- merge(unique(resA[, c("id", "name", "state")]), aud, by = "id")
  aud$flag_long_gap <- aud$longest_gap_years > 5             # flags used for a sensitivity analysis
  write.csv(aud, file.path(out_dir, "step07_flow_audit.csv"), row.names = FALSE)

  ## year-by-year record of the Figure 1 streamflow gauges
  fig_ids <- unique(case_series$id[case_series$application == "USGS_streamflow"])
  yr_tab <- do.call(rbind, lapply(fig_ids, function(site) {
    d <- readRDS(file.path(flow_dir, paste0("dv_", site, ".rds")))
    yr <- as.integer(format(d$date, "%Y"))
    do.call(rbind, lapply(FLOW_YEARS, function(y) {
      x <- d$q[yr == y]
      data.frame(id = site, year = y, days_observed = length(x), zero_days = sum(x == 0),
                 mean_flow_cfs = if (length(x)) round(mean(x), 3) else NA)
    }))
  }))
  write.csv(yr_tab, file.path(out_dir, "step07_case_gauge_years.csv"), row.names = FALSE)

  ## sensitivity: drop gauges with a gap > 5 years; and Zipper et al. style rounding (q < 0.05 cfs -> 0)
  sens <- function(r, label) data.frame(subset = label, n_series = nrow(r),
    sig_MK_full = mean(r$p_MK_full < 0.05), sig_TwoPart = mean(r$p_TwoPart < 0.05),
    TwoPart_only = mean(r$p_TwoPart < 0.05 & r$p_MK_full >= 0.05),
    MKfull_only = mean(r$p_MK_full < 0.05 & r$p_TwoPart >= 0.05), share_Sen_zero = mean(r$sen_zero))
  ok_ids <- aud$id[!aud$flag_long_gap]
  flow_r <- do.call(rbind, lapply(cand$site_no, function(site) {   # monthly tables with rounded daily flows
    f <- file.path(flow_dir, paste0("dv_", site, ".rds")); if (!file.exists(f)) return(NULL)
