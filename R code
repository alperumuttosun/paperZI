## ---- Data generator ---------------------------------------------------------
gen_series <- function(n, p0, b_occ, b_amt, dist = "gamma") {
  t  <- 1:n
  tc <- (t - (n + 1) / 2) / (n - 1)
  pw <- plogis(qlogis(1 - p0) + b_occ * tc)
  mu <- MU0 * exp(b_amt * tc)
  wet <- rbinom(n, 1, pw)
  amt <- if (dist == "gamma") {
    rgamma(n, shape = SHAPE, rate = SHAPE / mu)
  } else {
    mu * exp(SIG_LN * rnorm(n) - SIG_LN^2 / 2)
  }
  list(y = wet * amt, pw = pw, mu = mu)
}

## ---- Exact null distributions -----------------------------------------------
kend_null <- function(nmax) {
  out <- vector("list", nmax); f <- 1
  out[[1]] <- f
  for (k in 2:nmax) {
    g  <- c(f, rep(0, k - 1))
    cs <- cumsum(g)
    f  <- (cs - c(rep(0, k), cs[seq_len(length(g) - k)])) / k
    out[[k]] <- f
  }
  out
}
KEND <- kend_null(max(N_GRID))

## ---- MK, Sen's slope and the two-part test ----------------------------------
S_stat <- function(x) {
  d <- outer(x, x, "-")
  sum(sign(d[lower.tri(d)]))
}

mk_asym <- function(x) {
  n <- length(x)
  if (n < 3) return(c(S = 0, z = 0, p = 1))
  S <- S_stat(x)
  tie <- rle(sort(x))$lengths
  v <- (n * (n - 1) * (2 * n + 5) - sum(tie * (tie - 1) * (2 * tie + 5))) / 18
  if (v <= 0) return(c(S = S, z = 0, p = 1))
  z <- if (S > 0) (S - 1) / sqrt(v) else if (S < 0) (S + 1) / sqrt(v) else 0
  c(S = S, z = z, p = 2 * pnorm(-abs(z)))
}

p_amt_exact <- function(S, m) {
  if (m < 2) return(c(p = 1, mid = 1))
  k <- (m * (m - 1) / 2 - abs(S)) / 2
  f <- KEND[[m]]
  lo <- sum(f[seq_len(k)]); eq <- f[k + 1]
  c(p = min(1, 2 * (lo + eq)), mid = min(1, 2 * (lo + eq / 2)))  # conventional and mid-p
}

p_occ_exact <- function(S, n, m) {
  if (m == 0 || m == n) return(c(p = 1, mid = 1))
  U <- (S + m * (n - m)) / 2
  u <- min(U, m * (n - m) - U)
  lo <- if (u > 0) pwilcox(u - 1, m, n - m) else 0
  eq <- dwilcox(u, m, n - m)
  c(p = min(1, 2 * (lo + eq)), mid = min(1, 2 * (lo + eq / 2)))  # conventional and mid-p
}

sen_slope <- function(y, t) {
  if (length(y) < 2) return(NA_real_)
  d <- outer(y, y, "-"); dt <- outer(t, t, "-")
  median(d[lower.tri(d)] / dt[lower.tri(dt)])
}

p_fisher  <- function(p1, p2) pchisq(-2 * (log(max(p1, 1e-300)) + log(max(p2, 1e-300))),
                                     df = 4, lower.tail = FALSE)
p_stouffer <- function(z1, z2) 2 * pnorm(-abs((z1 + z2) / sqrt(2)))
p_cauchy  <- function(p) {
  p <- pmin(pmax(p, 1e-15), 1 - 1e-15)
  0.5 - atan(mean(tan((0.5 - p) * pi))) / pi
}

two_part <- function(y) {
  n <- length(y); t <- 1:n
  I <- as.numeric(y > 0); pos <- which(y > 0); m <- length(pos)
  full <- mk_asym(y); occ <- mk_asym(I); amt <- mk_asym(y[pos])
  occE <- p_occ_exact(occ[["S"]], n, m); amtE <- p_amt_exact(amt[["S"]], m)
  b_occ <- NA_real_; dE <- NA_real_; b_amt <- NA_real_
  if (m >= 2) b_amt <- sen_slope(log(y[pos]), pos)
  if (m > 0 && m < n) {
    fit <- suppressWarnings(glm.fit(cbind(1, t), I, family = binomial()))
    a <- fit$coefficients[1]; b_occ <- fit$coefficients[2]
    if (!is.na(b_amt)) {
      c0 <- mean(y[pos] * exp(-b_amt * pos))
      Ey <- function(s) plogis(a + b_occ * s) * c0 * exp(b_amt * s)
      dE <- Ey(n) - Ey(1)
    }
  }
  c(p_full = full[["p"]], S_full = full[["S"]], p_occ = occ[["p"]], z_occ = occ[["z"]],
    p_amt = amt[["p"]], z_amt = amt[["z"]], p_occ_ex = occE[["p"]], p_amt_ex = amtE[["p"]],
    p_fisher = p_fisher(occ[["p"]], amt[["p"]]),
    p_fisher_ex = p_fisher(occE[["p"]], amtE[["p"]]),
    p_fisher_mid = p_fisher(occE[["mid"]], amtE[["mid"]]),
    p_stouffer = p_stouffer(occ[["z"]], amt[["z"]]),
    p_cauchy = p_cauchy(c(occ[["p"]], amt[["p"]])),
    sen_full = sen_slope(y, t), b_occ = b_occ, b_amt = b_amt, dE = dE, n_wet = m)
}

