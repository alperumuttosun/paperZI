true_bE <- function(n, p0, scen, dist) {
  eff <- scen_eff[[scen]]; tc <- ((1:n) - (n + 1) / 2) / (n - 1)
  E <- plogis(qlogis(1 - p0) + eff[1] * tc) * MU0 * exp(eff[2] * tc)
  ols_slope(E, 1:n)
}
