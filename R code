CFS2CMS <- 0.0283168                                         # 1 cubic foot per second = 0.0283168 m3/s (SI units)
flow_case <- cinfo$application == "USGS_streamflow"         # which panels are streamflow
unit_lab <- ifelse(flow_case, "mean flow, m\u00b3 s\u207b\u00b9", "total, mm")  # SI unit labels
