                     ifelse(cinfo$dir_occ > 0, "increasing", "decreasing"), ", amount ",
                     ifelse(cinfo$dir_amt > 0, "increasing", "decreasing"), ")")  # in-panel annotation
cs$panel <- factor(cinfo$panel[match(cs$key, cinfo$key)], levels = cinfo$panel)
cs$type <- ifelse(cs$value > 0, "Positive value", "Exact zero")
is_flow <- cs$application == "USGS_streamflow"              # streamflow rows of the case series
cs$value[is_flow] <- cs$value[is_flow] * CFS2CMS             # cfs -> m3/s (zeros stay zero)
win <- lapply(cinfo$application, function(a) if (a == "USGS_streamflow") FLOW_YEARS else YEARS)  # analysis window per panel
ann <- data.frame(panel = factor(cinfo$panel, levels = cinfo$panel), note = cinfo$note,
                  x = sapply(win, min) - 0.5,                # left edge of each panel's own window
                  y = tapply(cs$value, cs$panel, max)[cinfo$panel])
gaps <- do.call(rbind, lapply(seq_along(win), function(i) {  # runs of years without a complete record
  miss <- setdiff(win[[i]], cs$year[cs$panel == cinfo$panel[i]])
  if (length(miss) == 0) return(NULL)
  grp <- cumsum(c(1, diff(miss) != 1))                       # consecutive years -> one run
  data.frame(panel = factor(cinfo$panel[i], levels = cinfo$panel),
             xmin = tapply(miss, grp, min) - 0.5, xmax = tapply(miss, grp, max) + 0.5,
             what = "No complete record")
}))
