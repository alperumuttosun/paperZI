get_file <- function(url, dest) {                            # download only if not already on disk
  if (file.exists(dest) && file.size(dest) > 0) return(TRUE) # already there -> no download
  ok <- tryCatch({ download.file(url, dest, mode = "wb", quiet = TRUE); TRUE },
                 error = function(e) FALSE, warning = function(w) FALSE)
  if (!ok && file.exists(dest)) file.remove(dest)            # remove broken partial file
  ok
}

days_in_month <- function(y, m) {                            # number of days in month m of year y
  nxt <- as.Date(sprintf("%04d-%02d-01", y + (m == 12), m %% 12 + 1))  # first day of next month
  as.integer(format(nxt - 1, "%d"))                          # last day of this month
}

## monthly table from a daily series; wet_fun() says which days count as "wet"/"flowing"
monthly_from_daily <- function(id, year, month, v, wet_fun, stat = c("sum", "mean")) {
  stat <- match.arg(stat)                                    # monthly total (rain) or mean (flow)
  o <- order(year, month); year <- year[o]; month <- month[o]; v <- v[o]  # time order
  key <- paste(year, month)                                  # one group per year-month
  do.call(rbind, lapply(split(seq_along(v), key), function(ix) {
    x <- v[ix]; yy <- year[ix[1]]; mm <- month[ix[1]]        # one month of days
    nobs <- sum(!is.na(x)); wet <- !is.na(x) & wet_fun(x)    # valid and wet days
    a <- x[-length(x)]; b <- x[-1]; ok <- !is.na(a) & !is.na(b)  # consecutive valid pairs
    data.frame(id = id, year = yy, month = mm,
               complete = nobs >= 0.9 * days_in_month(yy, mm),   # >= 90 % of days observed
               value = if (stat == "sum") sum(x, na.rm = TRUE) else mean(x, na.rm = TRUE),
               n_wet = sum(wet),                             # wet (or flowing) days
               mean_wet = if (sum(wet) > 0) mean(x[wet]) else NA_real_,  # mean amount on wet days
               n01 = sum(ok & !wet_fun(a) & wet_fun(b)), n00 = sum(ok & !wet_fun(a) & !wet_fun(b)),
               n11 = sum(ok & wet_fun(a) & wet_fun(b)),  n10 = sum(ok & wet_fun(a) & !wet_fun(b)))
  }))
}

## ---- 14. Statistics for one real series ------------------------------------------
betaE_twopart <- function(y, t) {                            # two-part plug-in trend of E[y] per year
  I <- as.numeric(y > 0); pos <- which(y > 0); m <- length(pos)
  if (m < 3 || m == length(y)) return(NA_real_)              # needs wet and dry years
  fo <- firth_logit(t, I); ph <- plogis(fo[["a"]] + fo[["b"]] * t)  # occurrence curve
  bs <- sen_slope(log(y[pos]), t[pos])                       # Sen slope of log amount
  as <- median(log(y[pos]) - bs * t[pos])                    # median intercept
  sm <- mean(exp(log(y[pos]) - as - bs * t[pos]))            # smearing (median -> mean)
  ols_slope(ph * exp(as + bs * t) * sm, t)                   # slope of fitted E[y_t]
}

real_stats <- function(y, t, nw, mw) {                       # y monthly value, t years, nw wet days, mw mean wet amount
  n <- length(y); I <- as.numeric(y > 0); pos <- which(y > 0); m <- length(pos); n0 <- n - m
  full <- mk_asym(y); occ <- mk_asym(I); amt <- mk_asym(y[pos])     # MK full and parts
  occE <- p_occ_exact(occ[["S"]], n, m); amtE <- p_amt_exact(amt[["S"]], m)  # exact parts
  ok <- !is.na(mw); mk_nw <- mk_asym(nw); mk_mw <- mk_asym(mw[ok])  # classical index approach
  yp <- y[pos]
  data.frame(n_years = n, zero_share = round(n0 / n, 3),
             p_MK_full = full[["p"]], S_full = full[["S"]],
             sen_slope = sen_slope(y, t), sen_zero = sen_slope(y, t) == 0,
             identity_pred = abs(full[["S"]]) < choose(n0, 2),   # Theorem 1 with zeros only: Sen = 0 <=> |S| < C(n0, 2)
             identity_pred_ties = abs(full[["S"]]) < sum(choose(table(y), 2)),  # Theorem 1 exact: |S| < number of tied pairs
             p_occ_exact = occE[["p"]], p_amt_exact = amtE[["p"]],
             dir_occ = sign(occ[["S"]]), dir_amt = sign(amt[["S"]]),
             p_TwoPart = p_fisher(occE[["mid"]], amtE[["mid"]]),       # proposed test
             p_TwoMK_Bonf = min(1, 2 * min(occE[["p"]], amtE[["p"]])), # separate MK + Bonferroni
             p_Index_Bonf = min(1, 2 * min(mk_nw[["p"]], mk_mw[["p"]])),  # wet-day count & intensity MK + Bonferroni
             p_nwet = mk_nw[["p"]], p_meanwet = mk_mw[["p"]],
             betaE_TwoPart = betaE_twopart(y, t), betaE_OLS = ols_slope(y, t),  # units per year
             mean_pos = mean(yp), cv_pos = sd(yp) / mean(yp),
             gamma_shape = mean(yp)^2 / var(yp),             # method-of-moments gamma shape
             ac1_occ = suppressWarnings(cor(I[-1], I[-n])),  # lag-1 autocorrelation of occurrence (years)
             ac1_amt_rank = if (m >= 4) cor(rank(yp)[-1], rank(yp)[-m]) else NA)
}

run_series <- function(mon, min_years) {                     # apply real_stats to every id x calendar month
  mon <- mon[mon$complete, ]                                 # complete months only
  out <- lapply(split(mon, list(mon$id, mon$month), drop = TRUE), function(d) {
    d <- d[order(d$year), ]                                  # time order
    if (nrow(d) < min_years) return(NULL)                    # too short
    z <- mean(d$value == 0)                                  # share of zero months
    if (z < ZERO_RANGE[1] || z > ZERO_RANGE[2] || sum(d$value > 0) < 5) return(NULL)  # not zero-inflated enough
    tr <- colSums(d[, c("n01", "n00", "n11", "n10")])        # daily transitions (all years)
    cbind(data.frame(id = d$id[1], month = d$month[1]),
          real_stats(d$value, d$year, d$n_wet, d$mean_wet),
          p01_daily = tr[["n01"]] / (tr[["n01"]] + tr[["n00"]]),  # P(wet | dry), daily
          p11_daily = tr[["n11"]] / (tr[["n11"]] + tr[["n10"]]))  # P(wet | wet), daily
  })
  out <- do.call(rbind, out)
  if (!is.null(out)) {
    out$q_TwoPart <- p.adjust(out$p_TwoPart, "BH")           # FDR within application
    out$q_MK_full <- p.adjust(out$p_MK_full, "BH")
    out$q_TwoMK_Bonf <- p.adjust(out$p_TwoMK_Bonf, "BH")
    out$q_Index_Bonf <- p.adjust(out$p_Index_Bonf, "BH")
  }
  out
}

summarise_app <- function(r, label) {                        # one summary row per application
  sig <- function(p) mean(p < 0.05, na.rm = TRUE)            # share significant at 5 %
  nsig <- function(p) sum(p < 0.05, na.rm = TRUE)            # count significant at 5 %
  data.frame(application = label, n_series = nrow(r), n_sites = length(unique(r$id)),
             median_zero_share = median(r$zero_share),
             share_Sen_zero = mean(r$sen_zero, na.rm = TRUE),  # Sen slope exactly 0
             identity_agreement = mean(r$sen_zero == r$identity_pred, na.rm = TRUE),            # zeros-only version
             identity_agreement_ties = mean(r$sen_zero == r$identity_pred_ties, na.rm = TRUE),  # general version
             sig_MK_full = sig(r$p_MK_full), sig_TwoPart = sig(r$p_TwoPart),
             sig_TwoMK_Bonf = sig(r$p_TwoMK_Bonf), sig_Index_Bonf = sig(r$p_Index_Bonf),
             sig_occ = sig(r$p_occ_exact), sig_amt = sig(r$p_amt_exact),
             binom_p_TwoPart = binom.test(nsig(r$p_TwoPart), nrow(r), 0.05, "greater")$p.value,  # field significance (naive, independence)
             binom_p_MK_full = binom.test(nsig(r$p_MK_full), nrow(r), 0.05, "greater")$p.value,
             fdr_TwoPart = mean(r$q_TwoPart < 0.05), fdr_MK_full = mean(r$q_MK_full < 0.05),
             fdr_TwoMK_Bonf = mean(r$q_TwoMK_Bonf < 0.05), fdr_Index_Bonf = mean(r$q_Index_Bonf < 0.05),
             TwoPart_only = mean(r$p_TwoPart < 0.05 & r$p_MK_full >= 0.05),  # found only by two-part
             MKfull_only = mean(r$p_MK_full < 0.05 & r$p_TwoPart >= 0.05),   # found only by MK_full
             both_sig = mean(r$p_MK_full < 0.05 & r$p_TwoPart < 0.05),
             TwoPart_sig_given_Sen0 = if (any(r$sen_zero, na.rm = TRUE)) mean(r$p_TwoPart[which(r$sen_zero)] < 0.05) else NA,
             opposite_dir_share = mean(r$dir_occ * r$dir_amt < 0, na.rm = TRUE),
             drying_share = mean(r$p_occ_exact < 0.05 & r$dir_occ < 0, na.rm = TRUE))  # significant fall in occurrence
}

calib_tab <- function(r, label) {                            # quantiles of real-data features (for step04)
  v <- c("zero_share", "gamma_shape", "cv_pos", "ac1_occ", "ac1_amt_rank", "p01_daily", "p11_daily")
  data.frame(application = label, stat = v,
             t(sapply(v, function(x) setNames(round(quantile(r[[x]], c(0.1, 0.25, 0.5, 0.75, 0.9), na.rm = TRUE), 3),
                                               c("q10", "q25", "q50", "q75", "q90")))))
}

